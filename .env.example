# Ration Bolo settings. Every value is optional: the app starts with none of them.
# Copy to .env and fill in only what you have.

# Database. Default: SQLite file in ./data. Railway sets this for its PostgreSQL service.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ration_bolo

# Dealer dashboard PIN (demo default 1234).
# DEALER_PIN=1234

# Public HTTPS address of this app, needed for phone and WhatsApp audio URLs.
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# Wispr Flow API key (primary speech-to-text). Get it from the Wispr Flow developer portal / hackathon organisers.
# WISPR_API_KEY=

# Sarvam AI API key (backup speech-to-text and Bulbul text-to-speech). Get it at https://dashboard.sarvam.ai
# SARVAM_API_KEY=

# Twilio (voice, WhatsApp sandbox, SMS). From https://console.twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VOICE_NUMBER=+1XXXXXXXXXX
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# TWILIO_SMS_NUMBER=+1XXXXXXXXXX
