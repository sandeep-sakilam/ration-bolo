# Ration Bolo settings. Every value is optional: the app starts with none of them.
# Copy to .env and fill in only what you have. Missing keys show as "key not set"
# on the simulator banner and at /api/status, and a mock stands in.

# Database. Default: SQLite file in ./data. Railway sets this for its PostgreSQL service.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ration_bolo

# Seed the Hyderabad demo data when the database is empty (default true).
# SEED_DEMO=true

# Dealer dashboard PIN (demo default 1234).
# DEALER_PIN=1234

# Public HTTPS address of this app. Needed for phone and WhatsApp (audio URLs, webhook signatures).
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# "auto" (default) uses a real adapter when its keys are set; "mock" forces mocks.
# SPEECH_MODE=auto
# MESSAGING_MODE=auto
# SPEECH_TIMEOUT_SECONDS=6

# Wispr Flow API key (primary speech-to-text). Request it from the Wispr Flow developer
# platform (https://api-docs.wisprflow.ai) or the hackathon organisers.
# WISPR_API_KEY=
# WISPR_BASE_URL=https://platform-api.wisprflow.ai/api/v1/dash

# Sarvam AI API key (backup speech-to-text and Bulbul reply voice). Get it at https://dashboard.sarvam.ai
# SARVAM_API_KEY=
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=kavya

# Twilio (voice, WhatsApp sandbox, SMS). Account SID and auth token: https://console.twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Voice number bought in the console (Phone Numbers > Buy a number), E.164 format.
# TWILIO_VOICE_NUMBER=+1XXXXXXXXXX
# WhatsApp sandbox sender (Messaging > Try it out > Send a WhatsApp message).
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# SMS sender (usually the same as the voice number).
# TWILIO_SMS_NUMBER=+1XXXXXXXXXX

# Verify a self-registered phone with a one-time code by SMS: "optional" (default; the
# caller may skip) or "off".
# LINK_VERIFICATION=optional

# Indian telephony (stub, for the future toll-free number). Off unless TELEPHONY_PROVIDER=exotel.
# Keys: Exotel dashboard > API settings. SMS to India also needs DLT entity/template IDs.
# TELEPHONY_PROVIDER=twilio
# EXOTEL_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_CALLER_ID=          # your ExoPhone
# EXOTEL_SUBDOMAIN=api.in.exotel.com
# EXOTEL_FLOW_URL=           # call flow URL used for spoken reminders
# EXOTEL_DLT_ENTITY_ID=
# EXOTEL_DLT_TEMPLATE_ID=
